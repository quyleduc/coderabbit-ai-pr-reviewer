{
  "name": "openai-pr-reviewer",
  "version": "0.0.0",
  "private": true,
  "description": "Source-validated GitHub pull request reviewer with configurable LLM provider",
  "main": "lib/main.js",
  "scripts": {
    "build": "cp node_modules/@dqbd/tiktoken/tiktoken_bg.wasm dist/tiktoken_bg.wasm && tsc",
    "package": "ncc build --license licenses.txt",
    "act": "npm run build && npm run package && ./bin/act pull_request_target --secret-file .secrets",
    "format": "prettier --write '**/*.ts'",
    "format-check": "prettier --check '**/*.ts'",
    "lint": "eslint src/**/*.ts",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "all": "npm run build && npm run format-check && npm run lint && npm run package && npm test && npm run audit",
    "audit": "npm audit --audit-level=low"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quyleduc/coderabbit-ai-pr-reviewer.git"
  },
  "keywords": [
    "actions",
    "node",
    "setup"
  ],
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^9.1.1",
    "@dqbd/tiktoken": "^1.0.7",
    "@octokit/action": "^8.0.4",
    "@octokit/plugin-retry": "^8.1.1",
    "@octokit/plugin-throttling": "^11.0.5",
    "minimatch": "^11.0.1",
    "p-limit": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@typescript-eslint/eslint-plugin": "^5.59.6",
    "@typescript-eslint/parser": "^5.59.6",
    "@vercel/ncc": "^0.38.4",
    "eslint": "^8.41.0",
    "eslint-config-standard-with-typescript": "^36.0.0",
    "eslint-plugin-github": "^4.6.1",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-n": "^15.7.0",
    "eslint-plugin-promise": "^6.1.1",
    "prettier": "2.8.8",
    "typescript": "^5.9.3"
  }
}
